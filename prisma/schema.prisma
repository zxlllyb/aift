datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model StudyLog {
  id          Int      @id @default(autoincrement())
  subject     String
  startTime   DateTime @default(now())
  endTime     DateTime?
  duration    Int      @default(0)
}
